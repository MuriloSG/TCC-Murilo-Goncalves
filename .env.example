# Modelo de variáveis de ambiente do IFAgenda.
# Copie para .env e preencha. Detalhes em docs/operacao/configuracao.md e docs/operacao/deploy.md.
# Gere os segredos com: python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Obrigatórias: a aplicação não inicia sem elas ---
DJANGO_SECRET_KEY=
DJANGO_CREDENTIALS_KEY=

POSTGRES_DB=agendamento
POSTGRES_USER=agendamento
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Instalação ---
# 1 só no desenvolvimento. Em produção deixe vazio.
DJANGO_DEBUG=
# Nomes reais da instalação, separados por vírgula. Nunca use *.
DJANGO_ALLOWED_HOSTS=
# Base dos links dos e-mails (com https:// em produção).
DJANGO_SITE_URL=
# Console no desenvolvimento; SMTP em produção (credenciais na tela Configurações > E-mail).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_LOG_LEVEL=INFO

# --- Redis (cache público, limites de tentativa e notificações em tempo real) ---
REDIS_PASSWORD=
DJANGO_REDIS_URL=redis://:SENHA_DO_REDIS@redis:6379/0
DJANGO_CACHE_KEY_PREFIX=ifagenda

# --- HTTPS e proxy reverso (ligue conforme a topologia do proxy) ---
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUSTED_PROXY_SSL_HEADER=
DJANGO_TRUSTED_PROXY_COUNT=0
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_SECURE_HSTS_SECONDS=0

# --- Somente desenvolvimento: liberam comandos destrutivos. Nunca preencha em produção ---
DJANGO_ENVIRONMENT=
DJANGO_LOCAL_DATABASE=
