@startuml acesso
!include estilo.iuml
actor "Usuário\nAutenticado" as UA
actor "Gestor de\nUsuários" as GU
actor "Superadmin" as SA

rectangle "Acesso e administração" {
  usecase "Entrar no sistema" as UC1
  usecase "Definir ou recuperar\nsenha (RF20)" as UC2
  usecase "Consultar notificações\n(RF09, RF10)" as UC3
  usecase "Manter usuários (RF04)" as UC4
  usecase "Alterar perfil do\nusuário (RF04)" as UC5
  usecase "Importar usuários (RF19)" as UC6
  usecase "Manter perfis e\npermissões (RF18)" as UC7
  usecase "Configurar servidor\nde e-mail (RF27)" as UC8
}
UA -- UC1
UA -- UC2
UA -- UC3
GU -- UC4
GU -- UC5
GU -- UC6
SA -- UC7
SA -- UC8
@enduml
