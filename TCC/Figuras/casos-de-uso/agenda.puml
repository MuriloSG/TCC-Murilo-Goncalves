@startuml agenda
!include estilo.iuml
actor "Solicitante" as SOL
actor "Analista de\nReservas" as ANA

rectangle "Agenda" {
  rectangle "Solicitação" {
    usecase "Consultar\ndisponibilidade (RF05)" as A1
    usecase "Solicitar reserva (RF06)" as A2
    usecase "Acompanhar solicitações\ne agenda (RF23)" as A3
    usecase "Responder à\nalternativa (RF21)" as A4
    usecase "Cancelar a própria\nreserva (RF08)" as A5
    usecase "Cancelar ocorrência\nda própria aula (RF16)¹" as A6
  }
  rectangle "Análise" {
    usecase "Analisar solicitação" as B1
    usecase "Aprovar ou rejeitar\nsolicitação (RF07)" as B2
    usecase "Sugerir alternativa\n(RF21)" as B3
    usecase "Cancelar reserva (RF08)" as B4
    usecase "Criar solicitação em nome\nde outro usuário (RF22)" as B5
  }
}
SOL -- A1
SOL -- A2
SOL -- A3
SOL -- A5
SOL -- A6
A3 <. A4 : <<extend>>
B1 -- ANA
B4 -- ANA
B5 -- ANA
B2 .> B1 : <<extend>>
B3 .> B1 : <<extend>>
legend bottom left
  ¹ Exige que o usuário seja o docente da aula.
endlegend
@enduml
