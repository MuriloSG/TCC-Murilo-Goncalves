@startuml ensalamento
!include estilo.iuml
actor "Gestor do\nEnsalamento" as GE
actor "Gestor de\nCadastros" as GC

rectangle "Ensalamento e cadastros" {
  usecase "Consultar grade\ndo ensalamento" as E0
  usecase "Importar planilha de\nhorários (RF01, RF02)" as E1
  usecase "Decidir espaços\nencontrados" as E1b
  usecase "Cadastrar aula\nrecorrente (RF13)" as E2
  usecase "Alterar recorrência\n(RF14)" as E3
  usecase "Encerrar recorrência\n(RF15)" as E4
  usecase "Cancelar ocorrência\nde aula (RF16)" as E5
  usecase "Manter espaços (RF03)" as C1
  usecase "Manter cursos (RF17)" as C2
  usecase "Manter disciplinas (RF17)" as C3
  usecase "Manter turmas (RF17)" as C4
}
GE -- E0
GE -- E1
GE -- E2
GE -- E3
GE -- E4
GE -- E5
E1b .> E1 : <<extend>>
GC -- C1
GC -- C2
GC -- C3
GC -- C4
@enduml
